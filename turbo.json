{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "tasks": {
    "//#lint": {},
    "transit": { "dependsOn": ["^transit"] },
    "gen": { "dependsOn": ["^gen"], "cache": false },
    "typecheck": { "dependsOn": ["transit", "gen", "^gen"] },
    "build": { "dependsOn": ["transit", "^gen"], "outputs": [".output/**"] },
    "dev": { "dependsOn": ["^gen"], "cache": false, "persistent": true }
  }
}
