{
  "name": "trespass",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "gen": "turbo run gen",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "e2e": "turbo run e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "start": "bun run apps/client/.output/server/index.mjs",
    "worker": "bun apps/server/scripts/worker.ts",
    "create-admin-invite": "bun apps/server/scripts/create-admin-invite.ts",
    "healthcheck": "bun apps/client/scripts/healthcheck.ts",
    "map-assets": "bun run --cwd apps/client map-assets",
    "db:generate": "bun run --cwd apps/server db:generate",
    "restore-test": "bash deploy/restore-test.sh",
    "check-dns": "bash deploy/check-dns.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
