{
  "name": "@trespass/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./paraglide/*": "./src/paraglide/*.js",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "gen": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --output-structure locale-modules --silent",
    "dev": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --output-structure locale-modules --silent --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "fast-check": "4.10.2"
  }
}
