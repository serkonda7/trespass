# Copy to .env (chmod 600). Back this file up in your password manager.
DOMAIN=lp.example.de
# Restricted token from host/desec-setup.sh --token (can only write _acme-challenge TXT)
DESEC_TOKEN=
# Only for the first `up`; delete afterwards (state lives in ./ts-state)
TS_AUTHKEY=
# Leave empty = staging. Switch to production once staging works:
# ACME_CA=https://acme-v02.api.letsencrypt.org/directory
APP_VERSION=dev
# Signs sessions and device cookies (passed to the app as BETTER_AUTH_SECRET).
# At least 32 characters. Generate once: openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=
# Research (DESIGN §6). Without ANTHROPIC_API_KEY only the OSM/Wikidata scans
# run; the monthly LLM budget is set in Admin → Einstellungen (0 = no LLM use).
# SEARXNG_URL: e.g. http://searxng:8080 with `--profile research` (enable the
# json format in data/cache/searxng/settings.yml). RESEARCH=off stops every
# outbound research request. RESEARCH_BLOCKLIST: extra hosts, comma-separated.
ANTHROPIC_API_KEY=
RESEARCH=
SEARXNG_URL=
RESEARCH_BLOCKLIST=
# Optional integrations for later stages (all safe to leave empty):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SMTP_URL=
NTFY_URL=
HEALTHCHECK_URL=
# Tile regions (optional). TILES=off stops all tile downloads/extractions;
# PMTILES_BIN overrides the CLI in the worker image; TILES_BUILD_URL points at
# one Protomaps .pmtiles archive instead of probing the newest daily build.
TILES=
PMTILES_BIN=
TILES_BUILD_URL=
